# 复制为 .env 并替换占位值。.env 不入库。

# --- 必填 ---
DEVKB_LLM_API_KEY=sk-替换为你的DeepSeek密钥

# --- LLM（默认 DeepSeek，ADR-0004）---
# DEVKB_LLM_BASE_URL=https://api.deepseek.com
# DEVKB_LLM_MODEL=deepseek-chat

# --- 数据库（与 docker-compose.yml 默认值一致）---
# DEVKB_DATABASE_URL=postgresql+asyncpg://devkb:devkb-local@127.0.0.1:5432/devkb
# DEVKB_PG_USER=devkb
# DEVKB_PG_PASSWORD=devkb-local
# DEVKB_PG_DB=devkb
# DEVKB_PG_PORT=5432

# --- Embedding（ADR-0002 冻结值，一般不改）---
# DEVKB_EMBEDDING_MODEL_ID=Qwen/Qwen3-Embedding-0.6B
# DEVKB_EMBEDDING_DEVICE=cuda
# DEVKB_EMBEDDING_BATCH_SIZE=32

# --- 其他 ---
# DEVKB_APP_ENV=dev
# DEVKB_LOG_LEVEL=INFO
# DEVKB_CHUNK_TARGET_TOKENS=400
# DEVKB_RETRIEVAL_TOP_K=8
